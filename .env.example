# Copy to .env and fill in real values locally. Never commit .env.
# See docs/security/SECRETS_POLICY.md.

# Least-privilege Neon Postgres runtime connection string (apps/api).
# NEVER the Neon project owner/admin credential.
DATABASE_URL=

# Migration-only connection (broader privileges), used solely by the
# migration runner, never bound to the deployed Worker.
MIGRATIONS_DATABASE_URL=

ENVIRONMENT=development
